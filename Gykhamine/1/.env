# Fichier .env pour Gykhamine Studio
# Ce fichier permet de configurer les UUID des partitions sans modifier le code source.

# UUID de la partition principale GY (où sont stockés les projets et configs)
# Pour trouver votre UUID, tapez : lsblk -f ou sudo blkid
GY_PARTITION_UUID="UUID=7a8cbe9a-8869-4382-ab24-fa742fe90eca"

# UUID de la partition PostgreSQL (si vous utilisez une partition dédiée pour les données DB)
PG_PARTITION_UUID="UUID=16815455-ad07-4bc6-a9f9-ee9f0b0a6246"
