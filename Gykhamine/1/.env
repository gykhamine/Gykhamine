═══════════════════════════════════════════════════════════
GYKHAMINE STUDIO - CONFIGURATION MONTAGE GY (.env)
═══════════════════════════════════════════════════════════
--- IA & Llama.cpp ---
# Le binaire reste souvent système, mais le modèle peut être sur GY si vous l'y avez déplacé
LLAMA_SERVER_PATH=/usr/local/bin/llama-server
LLAMA_MODEL_PATH=/run/media/gykhamine/GY/models/qwen2.5-coder.gguf
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080

--- Serveurs & Ports ---
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_SSL_ENABLED=False
# Les clés SSL restent dans le dossier de config utilisateur ou système pour la sécurité
GUNICORN_SSL_CERT_PATH=~/.config/gykhamine_studio/ssl/cert.pem
GUNICORN_SSL_KEY_PATH=~/.config/gykhamine_studio/ssl/key.pem
AUTO_FIND_FREE_PORT=True
DEFAULT_PORT_RANGE_START=8000
DEFAULT_PORT_RANGE_END=8010

--- Chemins Système (DB & Logs) ---
# On déplace la DB et les logs sur le montage GY pour persistance et centralisation
LOG_FILE_PATH=/run/media/gykhamine/GY/logs/studio.log
DB_PATH=/run/media/gykhamine/GY/db/gykhamine_studio.db

--- PostgreSQL ---
PG_DEVICE=/dev/sda5
# Point de montage PG spécifique (souvent séparé pour les perfs/droits)
PG_MOUNT_POINT=/var/lib/pgsql/data
PG_DB_NAME=ma_base
PG_DB_USER=mon_user
PG_DB_PASSWORD=mot_de_passe
PG_BIND_IP=127.0.0.1

--- Redis ---
REDIS_MODE=local
REDIS_IP=127.0.0.1
REDIS_PORT=6379
# Données Redis stockées sur GY
REDIS_DATA_DIR=/run/media/gykhamine/GY/redis_data
REDIS_USE_PERSISTENCE=True
# Le .env cible pour la mise à jour auto est aussi sur GY
REDIS_ENV_PATH=/run/media/gykhamine/GY/Gykhamine/gy/.env
REDIS_UPDATE_ENV=True

--- NFS ---
NFS_SERVER_MODE=local
# Export NFS pointe vers le dossier media sur GY
NFS_EXPORT_DIR=/run/media/gykhamine/GY/gy/media
NFS_LAN_NETWORK=192.168.1.0/24
NFS_CLIENT_SERVER_IP=192.168.1.10
NFS_CLIENT_EXPORT_DIR=/srv/nfs
NFS_CLIENT_MOUNT_POINT=/run/media/gykhamine/GY/nfs_mount

--- Nginx ---
NGINX_CONF_PATH=/etc/nginx/nginx.conf
NGINX_MODE=reverse_proxy
NGINX_SERVER_NAME=localhost
NGINX_LISTEN_PORT=443
NGINX_UPSTREAM_NAME=gunicorn
NGINX_UPSTREAM_SERVERS=127.0.0.1:8000, 127.0.0.1:8001, 127.0.0.1:8002
NGINX_PROXY_PASS=http://gunicorn
NGINX_FORCE_HTTPS=True
# Les certificats SSL restent aux emplacements standards Nginx/Système
NGINX_SSL_CERT=/etc/pki/nginx/server.crt
NGINX_SSL_KEY=/etc/pki/nginx/private/server.key
# Les chemins statiques/media doivent pointer vers votre projet sur GY
NGINX_STATIC_URL=/static/
NGINX_STATIC_PATH=/run/media/gykhamine/GY/Gykhamine/gy/static/
NGINX_MEDIA_URL=/media/
NGINX_MEDIA_PATH=/run/media/gykhamine/GY/gy/media/
NGINX_MAX_BODY=20M
NGINX_READ_TIMEOUT=60s
NGINX_CONNECT_TIMEOUT=60s
NGINX_PROXY_BUFFERING=True
NGINX_SECURITY_HEADERS=True
NGINX_CUSTOM_REDIRECTS=/ancien -> /nouveau

--- SSH ---
SSH_SERVER_MODE=local
SSH_SERVER_PORT=22
SSH_CLIENT_HOST=192.168.1.10
SSH_CLIENT_PORT=22
SSH_CLIENT_USER=root
SSH_CLIENT_KEY=~/.ssh/id_rsa
SSH_CLIENT_AUTH_MODE=key

--- Python Venv ---
VENV_NAME=venv
# Si vous créez un venv, il sera créé dans le dossier du projet ouvert, 
# mais on peut définir un chemin par défaut sur GY si besoin
VENV_PATH=/run/media/gykhamine/GY/venvs

--- Général ---
THEME=dark
OPEN_BROWSER_ON_RUN=False
LAST_PROJECT=/run/media/gykhamine/GY/Gykhamine/gy
